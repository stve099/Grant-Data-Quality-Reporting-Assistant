# Copy this file to .env and fill in your key to enable AI features.
# The application works fully without a key (non-AI fallback mode).

# Anthropic Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by the AI analyst
# GRANT_ASSISTANT_MODEL=claude-sonnet-5

# --- AI provider selection (optional; the app runs fully without any key) ---
# GRANT_ASSISTANT_PROVIDER=anthropic   # anthropic (default) | openai | ollama

# OpenAI
# GRANT_ASSISTANT_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# GRANT_ASSISTANT_MODEL=gpt-4o-mini

# Ollama - local (keyless) or cloud. Needs: uv sync --extra openai
# GRANT_ASSISTANT_PROVIDER=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1   # cloud: https://ollama.com/v1
# OPENAI_API_KEY=                             # required for cloud only
# GRANT_ASSISTANT_MODEL=llama3.1

# --- Scheduled-audit email (optional) ---
# Passwords remain in environment variables; never put credentials in a profile YAML.
# GRANT_ASSISTANT_SMTP_HOST=smtp.example.org
# GRANT_ASSISTANT_SMTP_PORT=587
# GRANT_ASSISTANT_SMTP_USERNAME=
# GRANT_ASSISTANT_SMTP_PASSWORD=
# GRANT_ASSISTANT_SMTP_FROM=grant-reports@example.org
# GRANT_ASSISTANT_SMTP_TLS=true